# Copie este arquivo para ".env" e preencha
PORT=3000

# String de conexão do seu cluster MongoDB Atlas (Atlas > Connect > Drivers).
# Exemplo: mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Nome do banco onde os posts serão salvos (é criado sozinho no primeiro post):
MONGODB_DB=BD3-NoSQL-RedeSocial
